Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Cell Size: 0.5
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: Robot model
      Alpha: 0.6
      Description Source: Topic
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Show Names: false
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.3
      Frame Timeout: 5
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Lidar cloud
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /utlidar/cloud_livox_mid360
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 0
      Use Fixed Frame: true
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Trajectory
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odom/trajectory
      Color: 255; 170; 0
      Alpha: 1
      Line Style: Billboards
      Line Width: 0.03
      Buffer Length: 1
      Pose Style: None
      Offset:
        X: 0
        Y: 0
        Z: 0
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Color image
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/color/image_raw
      Normalize Range: true
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Depth image
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/depth/image_rect_raw
      # 16UC1 in mm: black = 0 m (no depth), white = 4 m and beyond
      Normalize Range: false
      Min Value: 0
      Max Value: 4000
      Enabled: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: pelvis
      Distance: 5.0
      Pitch: 0.5
      Yaw: 3.6
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Width: 1600
  Height: 1000
  Hide Left Dock: false
  Hide Right Dock: false
  Displays:
    collapsed: false
  Color image:
    collapsed: false
  Depth image:
    collapsed: false
  # Displays on the left, colour and depth images stacked on the right
  QMainWindow State: 
