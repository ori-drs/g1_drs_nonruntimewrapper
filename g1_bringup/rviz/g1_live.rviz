Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Cell Size: 0.5
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: Robot model
      Alpha: 0.6
      Description Source: Topic
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Show Names: false
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.3
      Frame Timeout: 5
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Lidar cloud
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /utlidar/cloud_livox_mid360
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 0
      Use Fixed Frame: true
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odom
      Keep: 200
      Position Tolerance: 0.05
      Angle Tolerance: 0.1
      Shape:
        Value: Axes
        Axes Length: 0.2
        Axes Radius: 0.01
      Covariance:
        Value: false
      Enabled: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: pelvis
      Distance: 5.0
      Pitch: 0.4
      Yaw: 3.6
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Width: 1600
  Height: 1000
  Hide Left Dock: false
  Hide Right Dock: true
  Displays:
    collapsed: false
  Views:
    collapsed: true
