<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_bringup</name>
  <version>0.1.0</version>
  <description>
    Launch files for the Unitree G1: robot.launch.xml on PC2 (state bridge, robot_state_publisher,
    lidar mount TF) and visualization.launch.xml on the operator laptop (RViz2).
  </description>
  <maintainer email="kebl8470@ox.ac.uk">ori</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch_xml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>g1_description</exec_depend>
  <!-- robot.launch.xml (PC2) only -->
  <exec_depend>g1_state_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <!-- visualization.launch.xml (laptop) only -->
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rviz_default_plugins</exec_depend>
  <exec_depend>rqt_tf_tree</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
