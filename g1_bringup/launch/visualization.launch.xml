<?xml version="1.0"?>
<!--
  Laptop: RViz2 (and optionally rqt_tf_tree) for the live G1.
  The robot publishes TF and /robot_description (robot.launch.xml on PC2). This computer only
  needs g1_description installed, so RViz can load the meshes.

    ros2 launch g1_bringup visualization.launch.xml
-->
<launch>
  <arg name="rviz_config" default="$(find-pkg-share g1_bringup)/rviz/g1_live.rviz"/>
  <arg name="fixed_frame" default="odom"
       description="RViz fixed frame (odom, or pelvis for the body view)"/>
  <arg name="tf_tree_gui" default="false" description="Also open rqt_tf_tree"/>

  <node pkg="rviz2" exec="rviz2" name="rviz2" output="log"
        args="-d $(var rviz_config) -f $(var fixed_frame)"/>
  <node pkg="rqt_tf_tree" exec="rqt_tf_tree" name="rqt_tf_tree" output="log"
        args="--force-discover" if="$(var tf_tree_gui)"/>
</launch>
